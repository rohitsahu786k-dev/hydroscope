NEXT_PUBLIC_SITE_URL=https://hydroscope.in
NEXT_PUBLIC_API_URL=http://localhost:3000/api
DATABASE_URI=mongodb+srv://user:password@cluster.mongodb.net/hydroscope
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/hydroscope
PAYLOAD_SECRET=replace-with-a-long-random-secret
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_FOLDER=hydroscope
CONTACT_NOTIFICATION_EMAIL=contact@hydroscope.in

# Contact form email runs from this Next.js web app. Configure either SMTP_* or Resend.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@hydroscope.in
SMTP_PASS=replace-with-mailbox-password
SMTP_FROM="HYDROscope Website <contact@hydroscope.in>"
RESEND_API_KEY=
RESEND_FROM="HYDROscope Website <contact@hydroscope.in>"
