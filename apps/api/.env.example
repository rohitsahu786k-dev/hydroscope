NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/hydroscope
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
ADMIN_EMAIL=admin@hydroscope.in
ADMIN_PASSWORD=change-me-before-production

# Note: website contact-form email is sent by the Next.js web app.
# Set CONTACT_NOTIFICATION_EMAIL and SMTP_* or RESEND_* in apps/web/.env.local
# and in the deployed web app environment, not only in this API app.
